{
  "schema_version": "1.1",
  "title": "DemoCreate: Declarative Audio-Visual Demos",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "voice": "af_heart",
  "metadata": {
    "author": "Daniel Ari Friedman",
    "self_referential": true
  },
  "scenes": [
    {
      "id": "title",
      "title": "DemoCreate",
      "kind": "slide",
      "chunks": [
        {
          "id": "title-c",
          "text": "DemoCreate turns a single declarative file into a narrated, high definition walkthrough of your software.",
          "actions": []
        }
      ],
      "context": {
        "section": "Intro",
        "subtitle": "Declarative Audio-Visual Demos"
      }
    },
    {
      "id": "arch",
      "title": "Architecture",
      "kind": "slide",
      "chunks": [
        {
          "id": "arch-c",
          "text": "A declarative spine flows through narration, rendering and export. Outputs also depend on configuration, assets and the selected runtime environment.",
          "actions": [
            {
              "type": "open_file",
              "params": {
                "path": "Architecture"
              },
              "trigger_word": "stages",
              "timestamp_source": "authored"
            }
          ]
        }
      ],
      "context": {
        "section": "Architecture",
        "subtitle": "",
        "background_image": "assets/architecture.png"
      }
    },
    {
      "id": "spine",
      "title": "The Declarative Spine",
      "kind": "codebase",
      "chunks": [
        {
          "id": "spine-c",
          "text": "A demo is not a recording. It is a value: scenes of narration chunks, each chunk an ordered stream of typed actions.",
          "actions": [
            {
              "type": "create_file",
              "params": {
                "path": "src/democreate/schema.py",
                "code": "@dataclass\nclass Demo:\n    title: str\n    scenes: list[Scene]\n\n@dataclass\nclass Action:\n    type: ActionType\n    trigger_word: str | None"
              },
              "trigger_word": "value",
              "timestamp_source": "authored"
            },
            {
              "type": "highlight_lines",
              "params": {
                "lines": [
                  2,
                  3,
                  4
                ]
              },
              "trigger_word": "scenes",
              "timestamp_source": "authored"
            }
          ]
        }
      ],
      "context": {
        "section": "The Spine"
      }
    },
    {
      "id": "backends",
      "title": "Backends Behind Interfaces",
      "kind": "codebase",
      "chunks": [
        {
          "id": "backends-c",
          "text": "Core defaults run without heavy optional packages. Installed adapters can add capabilities; some declared adapters remain unwired, and voiced output needs a working speech backend.",
          "actions": [
            {
              "type": "create_file",
              "params": {
                "path": "src/democreate/narration/tts.py",
                "code": "class TTSBackend(ABC): ...\nclass SilentTTSBackend:   # no heavy deps\nclass SystemTTSBackend:   # needs usable OS speech\nclass KokoroTTSBackend:   # needs optional model"
              },
              "trigger_word": "interface",
              "timestamp_source": "authored"
            },
            {
              "type": "highlight_lines",
              "params": {
                "lines": [
                  2,
                  3
                ]
              },
              "trigger_word": "default",
              "timestamp_source": "authored"
            }
          ]
        }
      ],
      "context": {
        "section": "Backends"
      }
    },
    {
      "id": "sync",
      "title": "Audio Is Ground Truth",
      "kind": "codebase",
      "chunks": [
        {
          "id": "sync-c",
          "text": "Clip durations are measured. Known words are interpolated by length, not detected acoustically. Frames and waveform use the clip timeline.",
          "actions": [
            {
              "type": "create_file",
              "params": {
                "path": "src/democreate/narration/sync.py",
                "code": "clips = synthesize_demo(demo, ws)\nsync_demo(demo, clips)   # measured clips, heuristic words\n# video times are quantized to output frames"
              },
              "trigger_word": "measured",
              "timestamp_source": "authored"
            }
          ]
        }
      ],
      "context": {
        "section": "Sync"
      }
    },
    {
      "id": "dashboard",
      "title": "Interactive Player",
      "kind": "slide",
      "chunks": [
        {
          "id": "dashboard-c",
          "text": "The same demo exports an HTML caption and chapter preview with per-chunk frame navigation. The HTML preview has no audio track.",
          "actions": [
            {
              "type": "open_file",
              "params": {
                "path": "Interactive Player"
              },
              "trigger_word": "player",
              "timestamp_source": "authored"
            }
          ]
        }
      ],
      "context": {
        "section": "Dashboard",
        "subtitle": "",
        "background_image": "assets/dashboard.png"
      }
    },
    {
      "id": "build",
      "title": "One Command",
      "kind": "terminal",
      "chunks": [
        {
          "id": "build-c",
          "text": "One command builds the deterministic demo: audio, frames, captions, and the player.",
          "actions": [
            {
              "type": "run_command",
              "params": {
                "command": "democreate build demo.json -o output",
                "output": "✓ player: output/web/player.html"
              },
              "trigger_word": "builds",
              "timestamp_source": "authored"
            }
          ]
        }
      ],
      "context": {
        "section": "Build"
      }
    },
    {
      "id": "render",
      "title": "Render And Verify",
      "kind": "terminal",
      "chunks": [
        {
          "id": "render-c",
          "text": "Voiced rendering needs an explicitly selected speech backend. Basic verification checks streams, audio energy and picture variance, not intelligibility or acoustic word alignment.",
          "actions": [
            {
              "type": "run_command",
              "params": {
                "command": "democreate render demo.json --tts kokoro --voice af_heart",
                "output": "Illustrative output — not executed by DemoCreate: verification summary"
              },
              "trigger_word": "renders",
              "timestamp_source": "authored"
            }
          ]
        }
      ],
      "context": {
        "section": "Render"
      }
    },
    {
      "id": "outro",
      "title": "DemoCreate",
      "kind": "slide",
      "chunks": [
        {
          "id": "outro-c",
          "text": "This authored demonstration uses the same rendering pipeline. Edit the artifact and rebuild; inspect outputs and record their source and runtime identity before treating them as evidence.",
          "actions": []
        }
      ],
      "context": {
        "section": "Dogfooded",
        "subtitle": "github.com/docxology/democreate"
      }
    }
  ]
}